# Cloudflare Pages headers — applied to every response from the deployed site.
# Edit-then-commit: changes go live with the next deploy.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # font/style/connect: CHỈ để Sveltia CMS (/admin/cms/) tải icon Material Symbols +
  # font. Sveltia ≤0.173 dùng Google (googleapis+gstatic); ≥0.174 chuyển Fontsource
  # (cdn.jsdelivr.net). Cho phép CẢ HAI → nâng/hạ version Sveltia không phải sửa CSP.
  # Site pages KHÔNG bị nới thật — mỗi page còn 1 meta CSP `font-src 'self'`
  # (BaseLayout/ShopLayout) → browser áp giao 2 lớp → vẫn self-host. Chỉ 2 trang admin
  # (không có meta CSP) hưởng phần nới. (Không scope được qua rule /admin/cms/* riêng:
  #  Cloudflare GỘP header trùng tên → 2 CSP → browser áp giao → font vẫn bị chặn.)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https://unpkg.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://images.unsplash.com https://avatars.githubusercontent.com; connect-src 'self' https://api.github.com https://github.com https://unpkg.com https://api.web3forms.com https://cloudflareinsights.com https://fonts.googleapis.com https://cdn.jsdelivr.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://github.com https://api.web3forms.com;

# Admin dashboard + CMS — noindex, no-cache
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate

# Sveltia CMS shell (moved to /admin/cms/)
/admin/cms/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate

# Static assets — long cache (filenames have content hash via Astro)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — long cache + CORS for cross-origin font loads
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Uploads — Cloudflare _headers: khi nhiều rule khớp cùng path, RULE ĐỨNG SAU
# THẮNG → đặt fallback generic TRƯỚC, rule cụ thể SAU để override đúng.

# Fallback cho mọi upload (mặc định an toàn: cache vừa phải)
/uploads/*
  Cache-Control: public, max-age=86400, must-revalidate

# gen-script (tên file CỐ ĐỊNH: cat-*.webp, <slug>.webp) — có thể bị thay bằng
# ảnh chụp thật cùng tên → giữ cache ngắn để bản mới hiện trong ~1 ngày.
/uploads/products/*
  Cache-Control: public, max-age=86400
/uploads/blog/*
  Cache-Control: public, max-age=86400

# admin upload (tên file UNIQUE mỗi swap: <area>-<ts>-<rand>.webp) — cache vĩnh
# viễn an toàn vì URL cũ không bao giờ tái dùng (swap = filename mới).
/uploads/phong-mau/*
  Cache-Control: public, max-age=31536000, immutable
/uploads/combos/*
  Cache-Control: public, max-age=31536000, immutable
/uploads/hero/*
  Cache-Control: public, max-age=31536000, immutable
/uploads/projects/*
  Cache-Control: public, max-age=31536000, immutable
/uploads/sofa-may/*
  Cache-Control: public, max-age=31536000, immutable
