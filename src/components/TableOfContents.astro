---
/**
 * TableOfContents.astro — mục lục tự động cho bài dài (blog/[slug]).
 * Quét h2 trong container (mặc định .blog-body) ở client, gán id, dựng anchor list
 * fixed ở lề trái (chỉ ≥1200px), active-state qua IntersectionObserver.
 * Ẩn khi < 2 heading (không đủ để cần mục lục). Nhãn từ site.yml.
 */
import site from '../data/site.yml';

interface Props {
  /** Selector của vùng nội dung chứa h2. */
  target?: string;
}
const { target = '.blog-body' } = Astro.props;
const r = (site as any).reading ?? {};
---
<nav class="toc" data-toc-target={target} aria-label={r.tocLabel ?? 'Mục lục'} hidden>
  <div class="toc__label">{r.tocLabel ?? 'Trong bài này'}</div>
  <ol class="toc__list"></ol>
</nav>

<style>
  .toc { display: none; }
  @media (min-width: 1200px) {
    .toc:not([hidden]) {
      display: block;
      position: fixed;
      top: 180px;
      left: 32px;
      width: 200px;
      max-height: calc(100vh - 240px);
      overflow-y: auto;
      z-index: 50;
    }
  }
  .toc__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--earth);
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }
  .toc__list { list-style: none; margin: 0; padding: 0; }
  .toc__list :global(li) { margin: 0; }
  .toc__list :global(a) {
    display: block;
    padding: 6px 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    color: var(--earth);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 12px;
    margin-left: -14px;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc__list :global(a:hover) { color: var(--ink); }
  .toc__list :global(a.is-active) {
    color: var(--bark);
    border-left-color: var(--accent);
  }
</style>

<script>
  (() => {
    const nav = document.querySelector<HTMLElement>('.toc');
    if (!nav) return;
    const target = nav.dataset.tocTarget || '.blog-body';
    const container = document.querySelector<HTMLElement>(target);
    if (!container) return;

    const heads = Array.from(container.querySelectorAll<HTMLElement>('h2'));
    if (heads.length < 2) return; // không đủ để cần mục lục

    const slug = (s: string) =>
      s
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '') // bỏ dấu thanh tổ hợp
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .slice(0, 60) || 'muc';

    const used = new Set<string>();
    const list = nav.querySelector('.toc__list')!;
    const links: HTMLAnchorElement[] = [];

    heads.forEach((h) => {
      let id = h.id || slug(h.textContent || '');
      let unique = id;
      let n = 2;
      while (used.has(unique)) unique = `${id}-${n++}`;
      used.add(unique);
      h.id = unique;
      h.style.scrollMarginTop = '120px'; // tránh nấp dưới Nav fixed

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${unique}`;
      a.textContent = h.textContent || '';
      li.appendChild(a);
      list.appendChild(li);
      links.push(a);
    });

    nav.hidden = false;

    // Active-state: heading gần đỉnh viewport nhất.
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((a) => a.classList.remove('is-active'));
      byId.get(id)?.classList.add('is-active');
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive((visible[0].target as HTMLElement).id);
      },
      { rootMargin: '-120px 0px -65% 0px', threshold: 0 }
    );
    heads.forEach((h) => io.observe(h));
  })();
</script>
