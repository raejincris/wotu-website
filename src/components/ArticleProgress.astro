---
/**
 * ArticleProgress.astro — thanh tiến trình đọc, fixed top.
 * Dùng ở blog/[slug] + projects/[slug]. Width = tỉ lệ cuộn của trang.
 * Script bundle qua Astro (chỉ tải ở trang có component). rAF-throttle,
 * gate prefers-reduced-motion (vẫn hiện thanh, bỏ transition mượt).
 * 0 CLS — fixed overlay, chỉ đụng transform/width.
 */
---
<div class="art-progress" role="progressbar" aria-label="Tiến trình đọc" aria-hidden="true">
  <span class="art-progress__bar"></span>
</div>

<style>
  .art-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 1100;
    background: transparent;
    pointer-events: none;
  }
  .art-progress__bar {
    display: block;
    height: 100%;
    width: 0;
    transform-origin: left center;
    background: var(--accent);
  }
  /* Mượt khi không reduce; reduce → cập nhật tức thời mỗi frame. */
  @media (prefers-reduced-motion: no-preference) {
    .art-progress__bar { transition: width 0.08s linear; }
  }
</style>

<script>
  (() => {
    const bar = document.querySelector<HTMLElement>('.art-progress__bar');
    if (!bar) return;
    let ticking = false;
    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.width = (pct * 100).toFixed(2) + '%';
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
