---
import site from '../data/site.yml';
import shopHome from '../data/shop-home.yml';
import { jsonLd } from '../lib/jsonld';

interface Props {
  /** Page type — controls which JSON-LD schema is emitted. */
  type?: 'website' | 'article' | 'project';
  /** For article/project: title */
  title?: string;
  /** For article/project: description */
  description?: string;
  /** For article: ISO date published */
  datePublished?: string;
  /** Hero image URL */
  image?: string;
  /** Canonical URL of this page */
  url?: string;
}

const {
  type = 'website',
  title,
  description,
  datePublished,
  image,
  url,
} = Astro.props;

const SITE_URL = 'https://www.wotu.vn';
const ORG_NAME = 'WOTU';
// Tên phải khớp TỪNG KÝ TỰ với Google Business Profile ("WOTU - Nội thất Quy Nhơn")
// để Google nối được website ↔ Place — nền của Local SEO (NAP). Đổi ở đây thì phải
// đổi đồng thời trên GBP, 2 fanpage, Zalo OA. Xem WOTU SEO/ke-hoach-seo-aeo-geo-wotu.md mục 1.3.
const PLACE_NAME = 'WOTU - Nội thất Quy Nhơn';
// Tên pháp nhân THẬT trên giấy ĐKKD (trước đây là chuỗi mô tả tự đặt, không khớp
// hồ sơ nào). `taxID` giúp Google/AI đối chiếu doanh nghiệp với dữ liệu công khai.
const ORG_LEGAL_NAME = site.legal.companyName;
// foundingDate: đổi ngày cấp ĐKDN (dd/mm/yyyy) sang ISO. Trước đây chỉ có năm "2022"
// từ site.meta.est — nay là ngày thật trên giấy tờ, khớp dữ liệu doanh nghiệp công khai.
const [_d, _m, _y] = String(site.legal.issuedDate).split('/');
const FOUNDING_ISO = _y && _m && _d ? `${_y}-${_m}-${_d}` : site.meta.est;
const PHONE_INTL = '+84' + site.hotline.replace(/\s|^0/g, '');

// Always emit Organization + LocalBusiness on every page (root-level discovery).
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_URL}/#studio`,
  name: PLACE_NAME,
  alternateName: ORG_NAME,
  legalName: ORG_LEGAL_NAME,
  taxID: site.legal.taxCode,
  vatID: site.legal.taxCode,
  description: site.description,
  url: SITE_URL,
  telephone: PHONE_INTL,
  email: site.email,
  image: `${SITE_URL}/og.png`,
  logo: `${SITE_URL}/logo.svg`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: 'Quy Nhơn',
    addressRegion: 'Gia Lai',
    addressCountry: 'VN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Canonical từ company-info.md (place "WOTU - Nội thất Quy Nhơn" trên Google Maps).
    latitude: 13.7893,
    longitude: 109.2081161,
  },
  sameAs: [site.social.facebook, site.social.facebookWorkshop, site.social.maps].filter(Boolean),
  founder: {
    '@type': 'Organization',
    name: ORG_NAME,
  },
  foundingDate: FOUNDING_ISO,
  areaServed: {
    '@type': 'Country',
    name: 'Vietnam',
  },
  knowsAbout: [
    'Thiết kế kiến trúc',
    'Thiết kế nội thất',
    'Thi công nội thất',
    'Cải tạo nhà',
    'Tư vấn vật liệu',
  ],
  // AggregateRating từ tổng hợp đánh giá (shop-home.yml reviewsSummary) — SEO sao.
  ...((shopHome as any)?.reviewsSummary?.total > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: String((shopHome as any).reviewsSummary.average),
          reviewCount: (shopHome as any).reviewsSummary.total,
          bestRating: '5',
          worstRating: '1',
        },
      }
    : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: ORG_NAME,
  description: site.description,
  inLanguage: 'vi-VN',
  publisher: { '@id': `${SITE_URL}/#studio` },
};

const blogPosting = type === 'article' && title && datePublished
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: image ? [image] : undefined,
      datePublished,
      dateModified: datePublished,
      author: { '@id': `${SITE_URL}/#studio` },
      publisher: { '@id': `${SITE_URL}/#studio` },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': url,
      },
      inLanguage: 'vi-VN',
    }
  : null;

const creativeWork = type === 'project' && title
  ? {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: title,
      description,
      image: image ? [image] : undefined,
      creator: { '@id': `${SITE_URL}/#studio` },
      url,
      inLanguage: 'vi-VN',
    }
  : null;

const graph = [localBusiness, website, blogPosting, creativeWork].filter(Boolean);
---
<script type="application/ld+json" set:html={jsonLd({ '@context': 'https://schema.org', '@graph': graph })} is:inline />
