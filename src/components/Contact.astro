---
import Reveal from './Reveal.astro';
import SplitWords from './SplitWords.astro';
import home from '../data/home.yml';
import site from '../data/site.yml';

const c = home.contact;

interface Field {
  label: string;
  name: string;
  type: string;
  placeholder?: string;
}
const fields = c.fields as Field[];

const accessKey = site.forms?.contactAccessKey ?? '';
const subject = site.forms?.contactSubject ?? '[WOTU] Liên hệ mới từ website';
---
<section id="contact" style="padding: var(--pad-section) var(--pad-x); background: var(--cocoa); color: var(--bone);">
  <div class="grid-2col" style="display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--gap); align-items: start;">
    <Reveal variant="reveal" delay={0}>
      <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; color: var(--clay); text-transform: uppercase; margin-bottom: 24px;">{c.number} · {c.label}</div>
      <SplitWords
        tag="h2"
        base={100}
        step={90}
        text={c.heading}
        style="font-family: var(--font-display); font-weight: 400; font-size: clamp(56px, 8vw, 140px); line-height: 1.0; color: var(--bone);"
      />
      <div class="contact-info" style="margin-top: 64px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; max-width: 480px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--clay); text-transform: uppercase;">
        <div>
          <div style="color: var(--taupe); margin-bottom: 8px;">Studio</div>
          <a class="contact-maplink" href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer">
            {site.address.line1},<br/>{site.address.city}
            <span class="contact-maplink__cue">Xem bản đồ →</span>
          </a>
        </div>
        <div>
          <div style="color: var(--taupe); margin-bottom: 8px;">Liên lạc</div>
          <div class="contact-row">
            <a class="contact-link" href={`tel:${site.hotline.replace(/\s+/g, '')}`} data-hotline data-cms="hotline">{site.hotline}</a>
            <button type="button" class="contact-copy" data-copy={site.hotline} aria-label="Sao chép số điện thoại">⧉</button>
          </div>
          <div class="contact-row">
            <a class="contact-link" href={`mailto:${site.email}`} data-cms="email">{site.email}</a>
            <button type="button" class="contact-copy" data-copy={site.email} aria-label="Sao chép email">⧉</button>
          </div>
        </div>
      </div>

      <a class="contact-map contact-map--noimg" href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Mở vị trí studio trên Google Maps">
        <img class="contact-map__img" src="/uploads/studio-map.webp" alt={`Bản đồ vị trí studio WOTU · ${site.address.line1}, ${site.address.city}`} loading="lazy" decoding="async" hidden />
        <span class="contact-map__overlay">
          <span class="contact-map__pin" aria-hidden="true">◎</span>
          <span class="contact-map__text">{site.address.line1}, {site.address.city}</span>
          <span class="contact-map__cta">Mở Google Maps →</span>
        </span>
      </a>
    </Reveal>

    <Reveal variant="reveal" delay={400} style="padding-top: 32px;">
      <form id="wotu-contact-form" style="display: flex; flex-direction: column; gap: 32px;">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value={subject} />
        <input type="hidden" name="from_name" value="WOTU Website" />
        <input type="hidden" name="redirect" value="false" />

        {/* Honeypot — must remain empty; visible-but-aria-hidden trap for bots that ignore display:none */}
        <div style="position: absolute; left: -10000px; opacity: 0; pointer-events: none;" aria-hidden="true">
          <label>Đừng điền vào ô này</label>
          <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
        </div>

        {fields.map((f) => {
          const fieldId = `wotu-contact-${f.name}`;
          return (
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <label for={fieldId} style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--clay);">
                {f.label}
                {f.name !== 'phone' && <span style="color: var(--accent); margin-left: 4px;">*</span>}
              </label>
              {f.type === 'textarea' ? (
                <textarea id={fieldId} name={f.name} rows={2} placeholder={f.placeholder} required style="width: 100%; background: transparent; border: none; border-bottom: 1px solid rgba(245,240,232,0.25); padding: 12px 0; font-family: var(--font-display); font-size: 22px; color: var(--bone); outline: none; resize: none;"></textarea>
              ) : (
                <input
                  id={fieldId}
                  name={f.name}
                  type={f.type}
                  placeholder={f.placeholder}
                  required={f.name !== 'phone'}
                  style="width: 100%; background: transparent; border: none; border-bottom: 1px solid rgba(245,240,232,0.25); padding: 12px 0; font-family: var(--font-display); font-size: 22px; color: var(--bone); outline: none;"
                />
              )}
            </div>
          );
        })}

        <button type="submit" id="wotu-contact-submit" style="margin-top: 16px; padding: 18px 32px; min-height: 48px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; border: 1px solid var(--bone); background: var(--bone); color: var(--ink); cursor: pointer; align-self: start; transition: opacity 200ms;">
          {c.submitLabel}
        </button>

        <div id="wotu-contact-feedback" role="status" aria-live="polite" style="font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--clay); min-height: 1em;"></div>
      </form>
    </Reveal>
  </div>
</section>

<script>
  import { viValidate } from '../lib/form-vi';
  import { copyLink, studioToast } from '../lib/share';

  const form = document.getElementById('wotu-contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('wotu-contact-submit') as HTMLButtonElement | null;
  const feedback = document.getElementById('wotu-contact-feedback') as HTMLDivElement | null;

  // Click-to-copy hotline + email.
  document.querySelectorAll<HTMLButtonElement>('.contact-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      const ok = await copyLink(text);
      studioToast(ok ? `Đã sao chép: ${text}` : 'Không sao chép được, hãy thử lại');
    });
  });

  // Ảnh bản đồ tĩnh: chỉ hiện nếu file /uploads/studio-map.webp tồn tại.
  const mapWrap = document.querySelector<HTMLElement>('.contact-map');
  const mapImg = document.querySelector<HTMLImageElement>('.contact-map__img');
  if (mapWrap && mapImg) {
    mapImg.addEventListener('load', () => {
      if (mapImg.naturalWidth > 1) {
        mapImg.hidden = false;
        mapWrap.classList.remove('contact-map--noimg');
      }
    });
  }

  if (form) viValidate(form);

  if (form && submitBtn && feedback) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);

      // Honeypot — bot fills this, real users don't.
      if ((data.get('botcheck') ?? '').toString().length > 0) {
        feedback.textContent = '';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.5';
      submitBtn.classList.add('is-sending');
      submitBtn.textContent = 'Đang gửi…';
      feedback.style.color = 'var(--clay)';
      feedback.textContent = '';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(Object.fromEntries(data)),
        });
        const json = await response.json();

        if (response.ok && json.success) {
          form.reset();
          submitBtn.classList.remove('is-sending');
          feedback.style.color = 'var(--accent)';
          const msg =
            (form.dataset.successMessage as string | undefined) ??
            'Cảm ơn bạn, chúng tôi sẽ liên hệ trong 24h.';
          feedback.textContent = msg;
          submitBtn.textContent = 'Đã gửi ✓';
          studioToast('Đã gửi yêu cầu ✓');
        } else {
          throw new Error(json.message || 'Server returned an error.');
        }
      } catch (err) {
        submitBtn.classList.remove('is-sending');
        feedback.style.color = '#E07a5F';
        feedback.textContent =
          'Có lỗi xảy ra. Vui lòng thử lại hoặc gọi trực tiếp ' +
          ((document.querySelector('[data-hotline]') as HTMLElement | null)?.textContent ?? 'hotline');
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.textContent = (form.dataset.submitLabel as string | undefined) ?? 'Gửi yêu cầu';
        studioToast('Gửi không thành công, vui lòng thử lại');
      }
    });
  }
</script>

<style>
  section :global(h2 em) { font-style: italic; color: var(--accent); }

  .contact-maplink {
    color: var(--clay);
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s;
  }
  .contact-maplink:hover { color: var(--bone); }
  .contact-maplink__cue {
    display: block;
    margin-top: 8px;
    color: var(--taupe);
    font-size: 10px;
  }
  .contact-maplink:hover .contact-maplink__cue { color: var(--accent); }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .contact-link {
    color: var(--clay);
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-link:hover { color: var(--bone); }
  .contact-copy {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid rgba(245, 240, 232, 0.25);
    border-radius: 2px;
    color: var(--clay);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .contact-copy:hover { border-color: var(--bone); color: var(--bone); }
  .contact-copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .contact-map {
    display: block;
    position: relative;
    margin-top: 40px;
    max-width: 480px;
    aspect-ratio: 16 / 7;
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(245, 240, 232, 0.18);
  }
  .contact-map__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* `hidden` (mặc định, JS bỏ khi ảnh load OK) PHẢI thắng display:block ở trên —
     CSS author đè [hidden] của UA nên ảnh 404 vẫn hiện alt text. Ẩn hẳn khi hidden. */
  .contact-map__img[hidden] { display: none; }
  /* Fallback khi chưa có ảnh bản đồ thật: gradient ấm dạng "bản đồ". */
  .contact-map--noimg {
    background:
      repeating-linear-gradient(0deg, rgba(245,240,232,0.05) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(245,240,232,0.05) 0 1px, transparent 1px 28px),
      linear-gradient(135deg, #3a2f24, #2a221a);
  }
  .contact-map__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 20px 24px;
    background: linear-gradient(90deg, rgba(20,16,12,0.55), rgba(20,16,12,0.15));
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-map__pin { font-size: 20px; color: var(--accent); line-height: 1; }
  .contact-map__text { color: var(--bone); }
  .contact-map__cta { color: var(--accent); font-size: 10px; }

  /* Spinner nhẹ khi đang gửi form. */
  #wotu-contact-submit.is-sending {
    position: relative;
    padding-right: 52px;
  }
  #wotu-contact-submit.is-sending::after {
    content: '';
    position: absolute;
    right: 24px;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border: 2px solid rgba(20, 16, 12, 0.25);
    border-top-color: var(--ink);
    border-radius: 50%;
    animation: contactSpin 0.7s linear infinite;
  }
  @keyframes contactSpin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    #wotu-contact-submit.is-sending::after { animation: none; }
  }
</style>
