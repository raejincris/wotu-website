---
import footer from '../data/footer.yml';
import site from '../data/site.yml';
import { SITE_VERSION } from '../lib/version';
import { navPages } from '../lib/custom-pages';

interface Link { label: string; href: string; }
interface Column { title: string; links: Link[]; }
const cols = (footer.columns as Column[]).map((c) => ({ ...c, links: [...c.links] }));

// Trang tuỳ chỉnh (admin) gắn cờ hiện-menu → thêm vào cột cuối của footer Studio.
const extraPages = navPages('studio');
if (extraPages.length && cols.length) {
  cols[cols.length - 1].links.push(...extraPages.map((p) => ({ label: p.title, href: `/${p.slug}/` })));
}

const isExternal = (href: string) => /^https?:\/\//.test(href);
---
<footer data-pagefind-ignore style="background: var(--cocoa); color: var(--clay); padding: 64px var(--pad-x) 32px; border-top: 1px solid rgba(245,240,232,0.1);">
  <div class="footer-grid" style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 64px; border-bottom: 1px solid rgba(245,240,232,0.1);">
    <div>
      <a href="/studio/" aria-label="WOTU Studio, về trang chủ" style="display: inline-block;">
        <img src="/logo-light.svg" alt="WOTU" width="200" height="82" loading="lazy" decoding="async" style="height: 56px; width: auto; display: block;" />
      </a>
      <p style="margin-top: 16px; font-size: 13px; color: var(--clay); max-width: 32ch; line-height: 1.6;" data-cms="tagline" set:html={footer.tagline}></p>
    </div>
    {cols.map((c) => (
      <div>
        <div style="font-family: var(--font-sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--taupe); margin-bottom: 16px;">{c.title}</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          {c.links.map((x) => (
            <a
              href={x.href}
              style="font-size: 14px; color: var(--bone);"
              target={isExternal(x.href) ? '_blank' : undefined}
              rel={isExternal(x.href) ? 'noopener noreferrer' : undefined}
            >{x.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <!-- Khối pháp nhân — bắt buộc theo Điều 29 NĐ 52/2013/NĐ-CP, hiện ở CẢ 2 phần
       (Shop + Studio) vì cùng một tên miền đã thông báo với Bộ Công Thương. -->
  <div class="footer-legal" style="padding-top: 24px; display: flex; justify-content: space-between; align-items: flex-start; gap: 28px; flex-wrap: wrap; font-family: var(--font-sans); font-size: 13px; line-height: 1.6; color: var(--taupe);">
    <div style="display: flex; flex-direction: column; gap: 4px; max-width: 62ch;">
      <strong style="color: var(--clay); font-weight: 600;">{site.legal.companyName}</strong>
      <span>Giấy CN ĐKDN / Mã số thuế: <b style="font-weight: 600;">{site.legal.taxCode}</b> — do {site.legal.issuedBy} cấp ngày {site.legal.issuedDate}</span>
      <span>Trụ sở: {site.legal.registeredAddress}</span>
      <span>Người đại diện &amp; chịu trách nhiệm nội dung: {site.legal.representative}</span>
    </div>
    {site.legal.moitUrl && (
      <a
        href={site.legal.moitUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Website đã thông báo với Bộ Công Thương, xem hồ sơ trên online.gov.vn"
      >
        <img src="/bo-cong-thuong.png" alt="Đã thông báo Bộ Công Thương" width="200" height="76" loading="lazy" decoding="async" style="display: block; height: 40px; width: auto;" />
      </a>
    )}
  </div>
  <div class="footer-bottom" style="padding-top: 24px; display: flex; justify-content: space-between; font-family: var(--font-sans); font-size: 13px; color: var(--taupe);">
    <div><span data-cms="copyright">{footer.copyright}</span> <span>· v{SITE_VERSION}</span></div>
    <div data-cms="signature">{footer.signature}</div>
  </div>
</footer>

<style>
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr 1fr !important; gap: 32px !important; }
    .footer-bottom { flex-direction: column; gap: 8px; }
    .footer-legal { gap: 18px !important; }
  }
  /* Galaxy S5 / iPhone SE narrow — 4 cột stack hết thành 1 cột */
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr !important; gap: 24px !important; }
  }

  /* Touch target for footer links */
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
</style>
