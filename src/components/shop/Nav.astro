---
import { navPages } from '../../lib/custom-pages';

interface NavLink { label: string; href: string; }

interface Props {
  /** Active nav item label (visual highlight). */
  active?: string;
}

const { active } = Astro.props;
const pathname = Astro.url.pathname;

// Desktop: 3 link chính + dropdown "Thêm" + 2 link đuôi — 9 link phẳng làm nav
// vỡ dòng đè logo (fix 15/07). Trang tuỳ chỉnh (admin, nav:true) vào dropdown
// để menu không phình khi thêm trang mới.
const primaryLinks: NavLink[] = [
  { label: 'Combo nội thất', href: '/combo/' },
  { label: 'Sản phẩm', href: '/san-pham/' },
  { label: 'Phòng mẫu', href: '/phong-mau/' },
];
const moreLinks: NavLink[] = [
  { label: 'Cảm hứng', href: '/#inspo' },
  { label: 'Bảo hành', href: '/#why' },
  ...navPages('shop').map((p) => ({ label: p.title, href: `/${p.slug}/` })),
];
const tailLinks: NavLink[] = [
  { label: 'Studio ↗', href: '/studio/' },
  { label: 'Tư vấn', href: '/#contact' },
];
// Drawer mobile: đủ mọi link, phẳng, đúng thứ tự cũ.
const allLinks: NavLink[] = [...primaryLinks, ...moreLinks, ...tailLinks];

const isCurrent = (l: NavLink): boolean => {
  const isRoute = l.href.startsWith('/') && !l.href.includes('#');
  return isRoute && (pathname === l.href || pathname.startsWith(l.href));
};
const moreIsCurrent = moreLinks.some(isCurrent);

const linkAttrs = (l: NavLink) => ({
  href: l.href,
  'aria-current': isCurrent(l) ? ('page' as const) : undefined,
  style: active === l.label ? 'color: var(--shop-accent-deep);' : undefined,
});
---
<nav class="shop-nav" data-pagefind-ignore>
  <div class="container shop-nav-inner">
    <a href="/" class="shop-brand" aria-label="WOTU, trang chủ shop">
      <img src="/logo.svg" alt="WOTU" width="160" height="64" style="height: 32px; width: auto; display: block;" />
    </a>
    <div class="shop-nav-links">
      {primaryLinks.map((l) => <a {...linkAttrs(l)}>{l.label}</a>)}
      {tailLinks.map((l) => <a {...linkAttrs(l)}>{l.label}</a>)}
      <details class:list={['shop-nav-more', { 'is-current': moreIsCurrent }]}>
        <summary>Xem thêm <span class="chev" aria-hidden="true">▾</span></summary>
        <div class="shop-nav-more-menu">
          {moreLinks.map((l) => <a {...linkAttrs(l)}>{l.label}</a>)}
        </div>
      </details>
    </div>
    <div class="shop-nav-cta">
      {/* Search: click → thanh input trượt ra bên trái, tìm ngay tại chỗ (Pagefind).
          Toggle vẫn là <a href="/tim-kiem/"> → no-JS về trang tìm kiếm; JS chặn để mở inline. */}
      <div class="shop-search" data-shop-search>
        <input class="shop-search-input" type="search" placeholder="Bạn muốn tìm gì?"
               aria-label="Tìm kiếm sản phẩm" autocomplete="off" enterkeyhint="search" tabindex="-1" />
        <a class="shop-icon-btn shop-search-toggle" href="/tim-kiem/" aria-label="Tìm kiếm sản phẩm"
           aria-expanded="false" aria-controls="shop-search-panel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </a>
        <div class="shop-search-panel" id="shop-search-panel" hidden>
          <div class="shop-search-results"></div>
        </div>
      </div>
      <button class="shop-icon-btn" id="wotu-cart-btn" aria-label="Mở giỏ hàng" type="button" style="position: relative;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="shop-badge-dot" id="wotu-cart-badge" hidden>0</span>
      </button>
      <a class="shop-btn shop-btn-primary" href="/#contact">Đặt tư vấn <span class="arr">→</span></a>
      <button type="button" class="shop-icon-btn shop-nav-toggle" aria-label="Mở menu" aria-expanded="false" aria-controls="wotu-shop-drawer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</nav>

{/* Drawer NGOÀI .shop-nav — nav có view-transition-name: shop-nav, để trong sẽ
    snapshot cả drawer khi chuyển trang. */}
<div id="wotu-shop-drawer" class="shop-drawer" role="dialog" aria-modal="true" aria-label="Menu điều hướng" hidden>
  <div class="shop-drawer-inner">
    <div class="shop-drawer-head">
      <a href="/" aria-label="WOTU, trang chủ shop">
        <img src="/logo-light.svg" alt="WOTU" width="160" height="64" loading="lazy" decoding="async" style="height: 30px; width: auto; display: block;" />
      </a>
      <button type="button" class="shop-drawer-close" aria-label="Đóng menu">×</button>
    </div>
    <nav class="shop-drawer-nav">
      {allLinks.map((l) => <a {...linkAttrs(l)}>{l.label}</a>)}
    </nav>
  </div>
</div>

<script>
  import { getCartCount, onChange } from '../../lib/shop-store';
  import { loadIndex, filterProducts, highlightMatch, type SearchEntry } from '../../lib/search/client';

  const btn = document.getElementById('wotu-cart-btn');
  const badge = document.getElementById('wotu-cart-badge');

  let prevN = -1;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function refreshBadge(): void {
    if (!badge) return;
    const n = getCartCount();
    if (n <= 0) {
      badge.hidden = true;
    } else {
      badge.hidden = false;
      badge.textContent = String(n);
      // Pulse khi số lượng tăng (không khi load/giảm), gate reduced-motion.
      if (!reduce && prevN >= 0 && n > prevN) {
        badge.classList.remove('pulse');
        void badge.offsetWidth; // restart animation
        badge.classList.add('pulse');
      }
    }
    prevN = n;
  }

  btn?.addEventListener('click', () => {
    const fn = (window as unknown as { __wotuOpenCart?: () => void }).__wotuOpenCart;
    if (typeof fn === 'function') fn();
  });

  refreshBadge();
  onChange(refreshBadge);

  // ===== Dropdown "Thêm" (desktop) — <details> native, JS chỉ enhancement =====
  const more = document.querySelector<HTMLDetailsElement>('.shop-nav-more');
  if (more) {
    const summary = more.querySelector<HTMLElement>('summary');
    document.addEventListener('click', (e) => {
      if (more.open && !more.contains(e.target as Node)) more.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && more.open) {
        more.open = false;
        summary?.focus();
      }
    });
    more.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { more.open = false; }));
  }

  // ===== Mobile drawer — cùng pattern Nav studio (hidden attr + focus-trap) =====
  const navToggle = document.querySelector<HTMLButtonElement>('.shop-nav-toggle');
  const drawer = document.getElementById('wotu-shop-drawer');
  const drawerClose = drawer?.querySelector<HTMLButtonElement>('.shop-drawer-close');

  const openDrawer = () => {
    if (!drawer || !navToggle) return;
    drawer.hidden = false;
    document.documentElement.classList.add('wotu-shop-drawer-open');
    navToggle.setAttribute('aria-expanded', 'true');
    // Đưa focus vào drawer cho keyboard user.
    requestAnimationFrame(() => drawerClose?.focus());
  };
  const closeDrawer = () => {
    if (!drawer || !navToggle) return;
    drawer.hidden = true;
    document.documentElement.classList.remove('wotu-shop-drawer-open');
    navToggle.setAttribute('aria-expanded', 'false');
    navToggle.focus();
  };

  navToggle?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeDrawer()));

  // Esc đóng + Tab focus-trap (giữ keyboard trong drawer khi mở — WCAG).
  document.addEventListener('keydown', (e) => {
    if (!drawer || drawer.hidden) return;
    if (e.key === 'Escape') { closeDrawer(); return; }
    if (e.key === 'Tab') {
      const list = Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);
      if (!list.length) return;
      const first = list[0];
      const last = list[list.length - 1];
      const act = document.activeElement;
      if (e.shiftKey && act === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && act === last) { e.preventDefault(); first.focus(); }
      else if (!drawer.contains(act)) { e.preventDefault(); first.focus(); }
    }
  });

  // ===== Inline search — blend Sản phẩm (product index, không dấu) + Nội dung (Pagefind) =====
  const searchWrap = document.querySelector<HTMLElement>('[data-shop-search]');
  if (searchWrap) {
    const sToggle = searchWrap.querySelector<HTMLAnchorElement>('.shop-search-toggle')!;
    const sInput = searchWrap.querySelector<HTMLInputElement>('.shop-search-input')!;
    const sPanel = searchWrap.querySelector<HTMLElement>('.shop-search-panel')!;
    const sResults = searchWrap.querySelector<HTMLElement>('.shop-search-results')!;

    const PRODUCT_CAP = 4, CONTENT_CAP = 4;
    const SUGGEST = ['Sofa', 'Combo', 'Bàn ăn', 'Giường', 'Thảm', 'Kệ TV'];
    const RKEY = 'wotu-recent-search';
    const getRecent = (): string[] => { try { return (JSON.parse(localStorage.getItem(RKEY) || '[]') as string[]).slice(0, 6); } catch { return []; } };
    const pushRecent = (q: string) => {
      q = q.trim(); if (!q) return;
      try {
        const cur = getRecent().filter((x) => x.toLowerCase() !== q.toLowerCase());
        cur.unshift(q);
        localStorage.setItem(RKEY, JSON.stringify(cur.slice(0, 6)));
      } catch {}
    };

    // Product index (fetch 1 lần, cache ở module client). Pagefind cho nội dung.
    let INDEX: SearchEntry[] = [];
    loadIndex().then((idx) => { INDEX = idx; });
    // Pagefind (WASM+worker) chỉ có ở bản build; dev/lỗi → bỏ qua nhóm nội dung.
    let pf: any = null, pfLoading: Promise<any> | null = null;
    const loadPf = () => {
      if (pf) return Promise.resolve(pf);
      if (!pfLoading) {
        const src = '/pagefind/pagefind.js';
        pfLoading = import(/* @vite-ignore */ src)
          .then(async (m: any) => { await m.init?.(); pf = m; return m; })
          .catch(() => null);
      }
      return pfLoading;
    };

    const esc = (s: string) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    let activeIdx = -1; // #2 keyboard nav: chỉ số kết quả đang chọn (-1 = không)
    const show = (html: string) => { sResults.innerHTML = html; sPanel.hidden = false; activeIdx = -1; };
    const resultLinks = () => Array.from(sResults.querySelectorAll<HTMLAnchorElement>('a.shop-search-result'));
    const setActive = (idx: number) => {
      const links = resultLinks();
      if (!links.length) return;
      activeIdx = Math.max(-1, Math.min(idx, links.length - 1));
      links.forEach((a, i) => a.classList.toggle('is-active', i === activeIdx));
      if (activeIdx >= 0) links[activeIdx].scrollIntoView({ block: 'nearest' });
    };
    const goSearch = () => {
      const q = sInput.value.trim();
      if (q) pushRecent(q);
      window.location.href = q ? `/tim-kiem/?q=${encodeURIComponent(q)}` : '/tim-kiem/';
    };

    const prodHtml = (e: SearchEntry, q: string) => {
      const media = e.img
        ? `<img src="${esc(e.img)}" alt="" loading="lazy" />`
        : `<span class="ssp-ph"></span>`;
      const price = e.priceText ? `<span class="ssp-price">${esc(e.priceText)}</span>` : '';
      // Tên SP tô đậm từ khoá (không dấu-aware); cat để thường.
      return `<a class="shop-search-result ssp" href="${esc(e.url)}">
        <span class="ssp-thumb">${media}</span>
        <span class="ssp-txt"><b>${highlightMatch(e.title, q)}</b><span>${esc(e.cat)}</span></span>${price}</a>`;
    };
    // excerpt của Pagefind chứa <mark> (build-time, an toàn) → giữ để tô đậm.
    const contHtml = (d: any) =>
      `<a class="shop-search-result" href="${esc(d.url)}"><b>${esc(d.meta?.title || d.url)}</b><span>${d.excerpt || ''}</span></a>`;

    const renderEmpty = () => {
      const rec = getRecent();
      let html = '';
      if (rec.length) {
        html += `<div class="shop-search-group"><p class="shop-search-gh">Tìm gần đây</p><div class="shop-search-chips">`
          + rec.map((q) => `<button type="button" class="shop-search-chip" data-q="${esc(q)}">↺ ${esc(q)}</button>`).join('')
          + `</div></div>`;
      }
      html += `<div class="shop-search-group"><p class="shop-search-gh">Gợi ý</p><div class="shop-search-chips">`
        + SUGGEST.map((q) => `<button type="button" class="shop-search-chip" data-q="${esc(q)}">${esc(q)}</button>`).join('')
        + `</div></div>`;
      show(html);
    };

    const buildResults = (prods: SearchEntry[], conts: any[], q: string): string | null => {
      if (!prods.length && !conts.length) return null;
      let html = '';
      if (prods.length) html += `<div class="shop-search-group"><p class="shop-search-gh">Sản phẩm</p>` + prods.map((e) => prodHtml(e, q)).join('') + `</div>`;
      if (conts.length) html += `<div class="shop-search-group"><p class="shop-search-gh">Bài viết &amp; trang</p>` + conts.map(contHtml).join('') + `</div>`;
      html += `<a class="shop-search-all" href="/tim-kiem/?q=${encodeURIComponent(q)}">Xem tất cả kết quả cho “${esc(q)}” →</a>`;
      return html;
    };

    let timer: number | undefined;
    const renderQuery = (q: string) => {
      const prods = filterProducts(INDEX, { q }).slice(0, PRODUCT_CAP);
      // Sản phẩm hiện NGAY (không chờ Pagefind); nội dung bồi thêm khi sẵn sàng.
      const first = buildResults(prods, [], q);
      show(first ?? `<p class="shop-search-state">Đang tìm…</p>`);
      loadPf().then(async (m) => {
        let conts: any[] = [];
        if (m) {
          const s = await m.search(q);
          if (sInput.value.trim() !== q) return; // query đổi khi đang chờ
          conts = await Promise.all(s.results.slice(0, CONTENT_CAP).map((x: any) => x.data()));
        }
        if (sInput.value.trim() !== q) return;
        const full = buildResults(prods, conts, q);
        show(full ?? `<p class="shop-search-state">Không thấy kết quả cho “${esc(q)}”. <a href="/tim-kiem/?q=${encodeURIComponent(q)}">Tìm rộng hơn</a>.</p>`);
      });
    };

    const openSearch = () => {
      searchWrap.classList.add('open');
      sToggle.setAttribute('aria-expanded', 'true');
      sInput.tabIndex = 0;
      loadPf();
      if (!sInput.value.trim()) renderEmpty(); else renderQuery(sInput.value.trim());
      requestAnimationFrame(() => sInput.focus());
    };
    const closeSearch = () => {
      searchWrap.classList.remove('open');
      sToggle.setAttribute('aria-expanded', 'false');
      sInput.tabIndex = -1;
      sPanel.hidden = true;
    };

    sToggle.addEventListener('click', (e) => {
      e.preventDefault();
      if (searchWrap.classList.contains('open')) {
        if (sInput.value.trim()) sInput.focus();
        else closeSearch();
      } else openSearch();
    });

    sInput.addEventListener('input', () => {
      const q = sInput.value.trim();
      window.clearTimeout(timer);
      if (!q) { renderEmpty(); return; }
      timer = window.setTimeout(() => renderQuery(q), 160);
    });

    sInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeSearch(); sToggle.focus(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIdx - 1); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const links = resultLinks();
        if (activeIdx >= 0 && links[activeIdx]) window.location.href = links[activeIdx].href;
        else goSearch();
      }
    });

    // Chip gợi ý / lịch sử → đổ vào input & tìm ngay.
    sResults.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest('.shop-search-chip') as HTMLElement | null;
      if (chip) { sInput.value = chip.dataset.q ?? ''; sInput.focus(); renderQuery(sInput.value.trim()); return; }
      const link = (e.target as HTMLElement).closest('a[href]');
      if (link) pushRecent(sInput.value); // lưu lịch sử khi chọn 1 kết quả
    });

    // Cmd/Ctrl+K → mở search toàn site.
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (searchWrap.classList.contains('open')) sInput.focus(); else openSearch();
      }
    });

    document.addEventListener('click', (e) => {
      if (searchWrap.classList.contains('open') && !searchWrap.contains(e.target as Node)) closeSearch();
    });
  }
</script>
