---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Placeholder from '../../../components/Placeholder.astro';
import Reveal from '../../../components/Reveal.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProjectItem from '../../../components/ProjectItem.astro';
import ArticleProgress from '../../../components/ArticleProgress.astro';
import ShareRow from '../../../components/ShareRow.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import { img } from '../../../lib/unsplash';
import site from '../../../data/site.yml';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;

// Dự án liên quan: ưu tiên cùng hạng mục (cat), sau đó lấp bằng dự án khác.
const allProjects = await getCollection('projects');
const others = allProjects.filter((x) => x.id !== entry.id);

// Điều hướng dự án trước / sau (giữ thứ tự collection — theo tên file/id).
const order = allProjects;
const pIdx = order.findIndex((x) => x.id === entry.id);
const prevProj = pIdx > 0 ? order[pIdx - 1] : null;
const nextProj = pIdx >= 0 && pIdx < order.length - 1 ? order[pIdx + 1] : null;
const rd = (site as any).reading ?? {};
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const related = [
  ...others.filter((x) => x.data.cat === p.cat),
  ...others.filter((x) => x.data.cat !== p.cat),
]
  .slice(0, 3)
  .map((x) => ({
    slug: x.id,
    name: x.data.name,
    id: x.data.id,
    loc: x.data.loc,
    cat: x.data.cat,
    tone: x.data.tone,
    ratio: x.data.ratio,
    photo: x.data.photo,
    photoAlt: x.data.photoAlt,
  }));

// OG image = ảnh hero dự án (Unsplash ID → URL 1200×630, hoặc ảnh local upload).
const heroPhoto = p.photoDetail ?? p.photo;
const ogImage = heroPhoto
  ? (heroPhoto.startsWith('/') || heroPhoto.startsWith('http')
      ? new URL(heroPhoto, Astro.site).href
      : img(heroPhoto, 1200, '16/9'))
  : undefined;
---
<BaseLayout title={`${p.name} — WOTU`} description={p.excerpt} ogImage={ogImage} schemaType="project">
  <Nav variant="inner" homeRoute="/studio/" />
  <ArticleProgress />
  <Breadcrumb items={[{ name: 'Studio', href: '/studio/' }, { name: 'Dự án', href: '/studio/projects' }, { name: p.name }]} />

  <header style="padding: 40px var(--pad-x) 64px;">
    <div style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; color: var(--earth); text-transform: uppercase; margin-bottom: 16px;">
      DỰ ÁN {p.id} · {p.cat}
    </div>
    <h1 style="font-family: var(--font-display); font-weight: 400; font-size: clamp(56px, 9vw, 140px); line-height: 1.0; color: var(--bark); max-width: 16ch;">
      {p.name}
    </h1>
    <div style="margin-top: 32px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; color: var(--earth); text-transform: uppercase;">
      {p.loc}
    </div>
    <ShareRow url={canonical} title={p.name} style="margin-top: 28px;" />
  </header>

  <Reveal variant="reveal-img" delay={150} style="padding: 0 var(--pad-x);">
    <Placeholder
      label={`${p.cat.toUpperCase()} · ${p.id}`}
      ratio="16/9"
      tone={p.tone}
      photo={p.photoDetail ?? p.photo}
      alt={p.photoAlt ?? p.name}
      sizes="100vw"
    />
  </Reveal>

  <article class="project-body" style="padding: var(--pad-section) var(--pad-x);">
    <div class="project-meta-grid" style="display: grid; grid-template-columns: 240px 1fr; gap: var(--gap); align-items: start; max-width: 1280px; margin: 0 auto;">
      <aside style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; color: var(--earth); text-transform: uppercase; line-height: 1.8;">
        <div style="border-top: 1px solid var(--ink); padding-top: 16px; margin-bottom: 24px;">
          <div style="color: var(--earth); font-size: 9px; margin-bottom: 4px;">Hạng mục</div>
          <div style="color: var(--ink);">{p.cat}</div>
        </div>
        <div style="border-top: 1px solid var(--line); padding-top: 16px; margin-bottom: 24px;">
          <div style="color: var(--earth); font-size: 9px; margin-bottom: 4px;">Địa điểm</div>
          <div style="color: var(--ink);">{p.loc}</div>
        </div>
        {p.year && (
          <div style="border-top: 1px solid var(--line); padding-top: 16px;">
            <div style="color: var(--earth); font-size: 9px; margin-bottom: 4px;">Hoàn thành</div>
            <div style="color: var(--ink);">{p.year}</div>
          </div>
        )}
      </aside>
      <div style="font-family: var(--font-sans); font-size: 17px; line-height: 1.75; color: var(--ink); max-width: 64ch;">
        <Content />
      </div>
    </div>
  </article>

  <ProjectGallery items={p.gallery} projectName={p.name} />

  {related.length > 0 && (
    <section style="padding: 0 var(--pad-x) var(--pad-section); max-width: 1280px; margin: 0 auto;">
      <div style="border-top: 1px solid var(--ink); padding-top: 28px; margin-bottom: 48px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; color: var(--earth); text-transform: uppercase;">
        Dự án liên quan
      </div>
      <div class="related-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px;">
        {related.map((r, i) => <ProjectItem p={r} delay={i * 80} />)}
      </div>
    </section>
  )}

  {(prevProj || nextProj) && (
    <nav class="proj-nav" aria-label="Dự án khác" style="padding: 0 var(--pad-x) 24px; max-width: 1280px; margin: 0 auto;">
      {prevProj ? (
        <a class="proj-nav__item" href={`/studio/projects/${prevProj.id}`}>
          <span class="proj-nav__dir">← {rd.prevLabel ?? 'Dự án trước'}</span>
          <span class="proj-nav__title">{prevProj.data.name}</span>
        </a>
      ) : <span />}
      {nextProj ? (
        <a class="proj-nav__item proj-nav__item--next" href={`/studio/projects/${nextProj.id}`}>
          <span class="proj-nav__dir">{rd.nextLabel ?? 'Dự án sau'} →</span>
          <span class="proj-nav__title">{nextProj.data.name}</span>
        </a>
      ) : <span />}
    </nav>
  )}

  <section style="padding: 0 var(--pad-x) var(--pad-section);">
    <a href="/studio/projects" style="display: inline-flex; align-items: center; min-height: 44px; padding: 12px 0; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink); border-bottom: 1px solid var(--ink);">← Tất cả dự án</a>
  </section>

  <Footer />
</BaseLayout>

<style>
  .proj-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  .proj-nav__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .proj-nav__item:hover { border-color: var(--ink); }
  .proj-nav__item--next { text-align: right; align-items: flex-end; }
  .proj-nav__dir {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--earth);
  }
  .proj-nav__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.15;
    color: var(--bark);
  }
  @media (max-width: 640px) {
    .proj-nav { grid-template-columns: 1fr; }
    .proj-nav__item--next { text-align: left; align-items: flex-start; }
  }
  .project-body :global(p) { margin-bottom: 1.4em; }
  @media (max-width: 900px) {
    .related-grid { grid-template-columns: 1fr 1fr !important; gap: 32px !important; }
  }
  @media (max-width: 768px) {
    .project-meta-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    .related-grid { grid-template-columns: 1fr !important; }
  }
</style>
