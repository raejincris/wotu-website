# Chuẩn hoá ký tự xuống dòng.
# Repo lưu LF, tránh việc máy Windows báo "modified" cho file không ai sửa.
* text=auto eol=lf

# File nhị phân: git không được đụng vào nội dung.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.webm  binary

# Script Windows phải giữ CRLF mới chạy đúng.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
